<!-- pages/index/index.wxml -->
<view class="app-container">
  
  <!-- Header -->
  <view class="app-header">
    <view class="logo">
      <text class="logo-icon">✦</text>
      <view class="logo-text-group">
        <text class="logo-title">LinkWord</text>
        <text class="logo-sub">联想记忆</text>
      </view>
    </view>
    <view class="header-actions">
      <view class="icon-btn" bindtap="openVocabIndex" hover-class="btn-hover" style="margin-right: 16rpx;">
        <text class="emoji-icon">📖</text>
      </view>
      <view class="icon-btn" bindtap="toggleFavorites" hover-class="btn-hover" style="margin-right: 16rpx;">
        <text class="emoji-icon">⭐</text>
      </view>
      <view class="icon-btn" bindtap="toggleHistory" hover-class="btn-hover">
        <text class="emoji-icon">🕒</text>
      </view>
    </view>
  </view>

  <!-- Main Workspace -->
  <view class="app-main">
    
    <!-- Input Panel -->
    <view class="input-card">
      <view class="input-header">
        <view class="input-header-left">
          <text class="input-title">输入单词</text>
          <text class="info-tip">用空格、逗号或换行分隔多个单词</text>
        </view>
        <view class="clear-text-btn" bindtap="clearWords" wx:if="{{wordsInputValue}}">
          <text class="clear-icon">✕</text>
          <text>清空</text>
        </view>
      </view>

      <view class="textarea-wrapper">
        <textarea id="words-input" class="words-textarea" placeholder="例如: pristine, obsolete, digital..." placeholder-class="textarea-placeholder" value="{{wordsInputValue}}" bindinput="onWordsInput" maxlength="-1" />
      </view>

      <!-- Tool Bar (Random + OCR + Word Index) -->
      <view class="input-toolbar">
        <view class="tool-btn tool-btn-random" bindtap="fillRandomWords">
          <text class="tool-icon">🎲</text>
          <text class="tool-text">随机试词</text>
        </view>
        <view class="tool-btn" bindtap="startOCR">
          <text class="tool-icon">📷</text>
          <text class="tool-text">拍照识别</text>
        </view>
        <view class="tool-btn tool-btn-highlight" bindtap="openVocabIndex">
          <text class="tool-icon">📖</text>
          <text class="tool-text">中文选词</text>
        </view>
      </view>

      <!-- Interactive Story Length Collapsible Container -->
      <view class="length-slider-container {{showLengthSlider ? 'expanded' : 'collapsed'}}">
        <view class="slider-header" bindtap="toggleLengthSlider">
          <view class="slider-header-left">
            <text class="slider-label">⚙️ 篇幅设定:</text>
            <view class="slider-current-badge">
              <text class="badge-icon">{{storyLengthInfo.icon}}</text>
              <text class="badge-text">{{storyLengthInfo.title}} ({{storyLengthInfo.desc}})</text>
            </view>
          </view>
          <view class="slider-toggle-btn">
            <text class="toggle-text">{{showLengthSlider ? '收起' : '调节'}}</text>
            <text class="toggle-arrow">{{showLengthSlider ? '▲' : '▼'}}</text>
          </view>
        </view>

        <!-- Hidden by default, expands when clicked -->
        <view class="slider-expand-body" wx:if="{{showLengthSlider}}">
          <view class="slider-track-wrap">
            <slider
              min="1"
              max="3"
              step="1"
              value="{{storyLengthValue}}"
              bindchange="onLengthSliderChange"
              bindchanging="onLengthSliderChanging"
              activeColor="#4f46e5"
              backgroundColor="#e2e8f0"
              block-size="22"
              block-color="#4f46e5"
            />
          </view>
          <view class="slider-scale-labels">
            <text class="scale-item {{storyLengthValue === 1 ? 'scale-active' : ''}}" data-val="1" bindtap="onScaleTap">⚡ 极简 (1-2句)</text>
            <text class="scale-item {{storyLengthValue === 2 ? 'scale-active' : ''}}" data-val="2" bindtap="onScaleTap">📖 标准 (3-4句)</text>
            <text class="scale-item {{storyLengthValue === 3 ? 'scale-active' : ''}}" data-val="3" bindtap="onScaleTap">🌟 长篇 (5-6句)</text>
          </view>
        </view>
      </view>

      <!-- Primary Action Button -->
      <view class="primary-btn-submit-full {{isGenerating ? 'disabled' : ''}}" bindtap="handleGeneration">
        <block wx:if="{{!isGenerating}}">
          <text class="submit-sparkle">✨</text>
          <text class="submit-text">串联记忆 · 生成故事</text>
        </block>
        <view wx:else class="spinner-small"></view>
      </view>
    </view>

    <!-- Empty State -->
    <view class="empty-state" wx:if="{{showEmptyState && !isGenerating}}">
      <view class="empty-icon">💡</view>
      <text class="empty-title">联想背单词</text>
      <text class="empty-desc">输入 2 个或更多英文单词，AI 将其串联成一段生动的趣味小故事，帮您轻松记住！</text>
    </view>

    <!-- Loading Skeleton Card -->
    <view class="loading-card" wx:if="{{isGenerating}}">
      <view class="loading-skeleton-title skeleton-blink"></view>
      <view class="loading-skeleton-text skeleton-blink"></view>
      <view class="loading-skeleton-text skeleton-blink"></view>
      <view class="loading-skeleton-text half-width skeleton-blink"></view>
      
      <view class="loading-tip-container">
        <text class="loading-tip-title">⚡ AI 正在疯狂联想中...</text>
        <text class="loading-tip-text">{{currentTip}}</text>
      </view>
    </view>

    <!-- Output Panel -->
    <view class="output-panel" wx:if="{{showOutput && !isGenerating}}">
      <!-- Story Card -->
      <view class="story-card">
        <view class="story-header">
          <text class="story-title">联想记忆故事</text>
          <view class="story-actions-group">
            <view class="speak-btn {{isStorySpeaking ? 'speaking' : ''}}" bindtap="toggleSpeakStory">
              <text class="speak-icon">🔊</text>
              <text class="speak-text">{{isStorySpeaking ? '播放中...' : '朗读故事'}}</text>
            </view>
            <button class="share-story-btn" open-type="share">
              <text class="share-icon">📤</text>
              <text class="share-text">分享</text>
            </button>
          </view>
        </view>
        <view class="story-body">
          <rich-text class="story-content" nodes="{{storyHtml}}"></rich-text>
          <text class="story-translation">{{storyTranslation}}</text>
        </view>
      </view>

      <!-- Vocabulary Grid -->
      <view class="vocab-section-title">记忆核心词汇</view>
      <view class="vocab-grid">
        <view class="vocab-card" wx:for="{{vocabList}}" wx:key="word">
          <view class="vocab-card-header">
            <view class="word-group">
              <text class="vocab-word">{{item.word}}</text>
              <text class="vocab-ipa" wx:if="{{item.ipa}}">{{item.ipa}}</text>
            </view>
            <view class="vocab-actions-group">
              <!-- Polysemy / Alt Meanings Switcher Trigger -->
              <view class="polysemy-tag {{activePolysemyIndex === index ? 'active' : ''}}" wx:if="{{item.alt_meanings && item.alt_meanings.length > 0}}" data-index="{{index}}" bindtap="togglePolysemyOptions">
                <text class="polysemy-tag-icon">🔄</text>
                <text class="polysemy-tag-text">多义词</text>
                <text class="polysemy-arrow">{{activePolysemyIndex === index ? '▲' : '▾'}}</text>
              </view>

              <view class="word-favorite-btn {{item.isFavorite ? 'active' : ''}}" bindtap="toggleFavoriteWord" data-index="{{index}}">
                <text class="fav-icon">{{item.isFavorite ? '★' : '☆'}}</text>
              </view>
              <view class="word-speak-btn" bindtap="speakSingleWord" data-word="{{item.word}}">
                <text class="word-speak-icon">🔊</text>
              </view>
            </view>
          </view>
          <view class="vocab-def-line">
            <text class="vocab-pos" wx:if="{{item.pos}}">{{item.pos}}</text>
            <text class="vocab-definition">{{item.definition}}</text>
          </view>

          <!-- Polysemy Dropdown Drawer -->
          <view class="polysemy-drawer" wx:if="{{activePolysemyIndex === index && item.alt_meanings && item.alt_meanings.length > 0}}">
            <view class="polysemy-drawer-header">
              <text class="polysemy-tip">💡 选择其他释义填入输入框，点击上方「串联记忆」即可生成：</text>
            </view>
            <view class="polysemy-list">
              <view class="polysemy-option" wx:for="{{item.alt_meanings}}" wx:for-item="alt" wx:key="def" data-word="{{item.word}}" data-def="{{alt.def}}" bindtap="selectWordMeaning">
                <view class="alt-left">
                  <text class="alt-pos" wx:if="{{alt.pos}}">{{alt.pos}}</text>
                  <text class="alt-def">{{alt.def}}</text>
                </view>
                <view class="alt-action-btn">
                  <text>换用此义</text>
                </view>
              </view>
            </view>
          </view>

          <view class="vocab-example-box" wx:if="{{item.sentence}}">
            <text class="example-label">例句：</text>
            <text class="example-text">{{item.sentence}}</text>
          </view>
        </view>
      </view>
    </view>

  </view>

  <!-- Sidebar Backdrop Drawer for Favorites -->
  <view class="sidebar-backdrop {{showFavorites ? 'active' : ''}}" bindtap="toggleFavorites" style="top: {{navHeight}}px; height: calc(100vh - {{navHeight}}px);"></view>
  <view class="favorites-sidebar {{showFavorites ? 'active' : ''}}" style="top: {{navHeight}}px; height: calc(100vh - {{navHeight}}px);">
    <view class="sidebar-header">
      <text class="sidebar-title">我的生词本</text>
      <view class="clear-history-btn" bindtap="clearFavorites">清空</view>
    </view>
    <scroll-view class="sidebar-scroll" scroll-y="true">
      <view class="fav-list" wx:if="{{favoritesList.length > 0}}">
        <view class="fav-item" wx:for="{{favoritesList}}" wx:key="word">
          <view class="fav-item-header">
            <view class="fav-word-group">
              <text class="fav-word">{{item.word}}</text>
              <text class="fav-def">{{item.pos}} {{item.definition}}</text>
            </view>
            <view class="fav-actions">
              <view class="fav-action-btn" bindtap="speakSingleWord" data-word="{{item.word}}">🔊</view>
              <view class="fav-action-btn delete" bindtap="removeFavorite" data-word="{{item.word}}">❌</view>
            </view>
          </view>
          <view class="fav-example" wx:if="{{item.sentence}}">
            <text class="fav-example-text">例：{{item.sentence}}</text>
          </view>
        </view>
      </view>
      <view class="history-empty" wx:else>
        <text>暂无收藏生词，在单词卡片上点击 ☆ 即可收藏</text>
      </view>
    </scroll-view>
  </view>

  <!-- Sidebar Backdrop Drawer for History -->
  <view class="sidebar-backdrop {{showHistory ? 'active' : ''}}" bindtap="toggleHistory" style="top: {{navHeight}}px; height: calc(100vh - {{navHeight}}px);"></view>
  <view class="history-sidebar {{showHistory ? 'active' : ''}}" style="top: {{navHeight}}px; height: calc(100vh - {{navHeight}}px);">
    <view class="sidebar-header">
      <text class="sidebar-title">记忆历史</text>
      <view class="clear-history-btn" bindtap="clearHistory">清空</view>
    </view>
    <scroll-view class="sidebar-scroll" scroll-y="true">
      <view class="history-list" wx:if="{{historyList.length > 0}}">
        <view class="history-item" wx:for="{{historyList}}" wx:key="index" bindtap="selectHistoryItem" data-index="{{index}}">
          <view class="history-words">{{item.wordsJoin}}</view>
          <view class="history-time">{{item.timeFormatted}}</view>
        </view>
      </view>
      <view class="history-empty" wx:else>
        <text>暂无历史生成记录</text>
      </view>
    </scroll-view>
  </view>

  <!-- Custom Crop / Highlight Editor Modal -->
  <view class="crop-editor-backdrop" wx:if="{{showCropEditor}}">
    <view class="crop-editor-card">
      <view class="crop-editor-header">
        <view class="crop-header-top">
          <text class="crop-editor-title">选择并识别英文</text>
          <view class="draw-mode-selector">
            <view class="mode-btn {{drawMode === 'brush' ? 'active' : ''}}" bindtap="changeDrawMode" data-mode="brush">✏️ 涂抹</view>
            <view class="mode-btn {{drawMode === 'box' ? 'active' : ''}}" bindtap="changeDrawMode" data-mode="box">⬜ 框选</view>
          </view>
        </view>
        <text class="crop-editor-tip">支持手指涂画高亮，或拉框选中想要识别的区域</text>
      </view>
      <view class="crop-editor-body">
        <view class="crop-image-container" style="position: relative; width: {{imageDisplayWidth}}px; height: {{imageDisplayHeight}}px; margin: 0 auto;">
          <image id="crop-source-img" class="crop-source-img" src="{{cropImgSrc}}" bindload="onCropImageLoad" style="width: 100%; height: 100%; display: block;" mode="aspectFit" />
          <canvas type="2d" id="crop-highlight-canvas" class="crop-highlight-canvas" style="position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 10;" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd"></canvas>
        </view>
      </view>
      <view class="crop-editor-footer">
        <view class="brush-size-selector">
          <view class="brush-dot thin {{brushSize === 'thin' ? 'active' : ''}}" bindtap="changeBrushSize" data-size="thin"></view>
          <view class="brush-dot medium {{brushSize === 'medium' ? 'active' : ''}}" bindtap="changeBrushSize" data-size="medium"></view>
          <view class="brush-dot thick {{brushSize === 'thick' ? 'active' : ''}}" bindtap="changeBrushSize" data-size="thick"></view>
        </view>
        <view class="text-btn-sm" bindtap="clearCropCanvas">重置</view>
        <view class="crop-footer-right">
          <view class="secondary-btn-sm" bindtap="cancelCropEditor">取消</view>
          <view class="primary-btn-submit" bindtap="confirmCropAndRunOCR">确认识别</view>
        </view>
      </view>
    </view>
  </view>

  <!-- Word Index & Chinese Selector Modal -->
  <view class="vocab-modal-backdrop" wx:if="{{showVocabModal}}" bindtap="closeVocabIndex">
    <view class="vocab-modal-card" catchtap="doNothing">
      <view class="vocab-modal-header">
        <view class="vocab-header-left">
          <text class="vocab-modal-title">📖 单词索引 (支持中文选词)</text>
          <text class="vocab-modal-sub">输入中文搜索对应英文单词，点击勾选一键填入</text>
        </view>
        <view class="close-modal-btn" bindtap="closeVocabIndex">✕</view>
      </view>

      <!-- Realtime Search Box -->
      <view class="vocab-search-box">
        <text class="search-lens-icon">🔍</text>
        <input class="vocab-search-field" placeholder="输入任意英文单词或中文 (如: ephemeral / 放弃)..." placeholder-class="textarea-placeholder" value="{{vocabSearchQuery}}" bindinput="onVocabSearchInput" bindconfirm="onVocabSearchConfirm" confirm-type="search" focus="{{showVocabModal}}" />
        <view class="clear-search-btn" bindtap="clearVocabSearch" wx:if="{{vocabSearchQuery}}">✕</view>
      </view>

      <!-- Candidate Word List Area -->
      <scroll-view class="vocab-list-scroll" scroll-y="true" enhanced="true" show-scrollbar="true" bounces="true">
        <view class="vocab-searching-indicator" wx:if="{{isSearchingOnline}}">
          <text class="search-loading-text">🌐 正在全网词典检索与联想中...</text>
        </view>

        <!-- Direct Add Word Card (Ensures 100% of all words in existence can be added) -->
        <view class="vocab-direct-add-card" wx:if="{{cleanQueryWord && isEnglishQuery}}" data-word="{{cleanQueryWord}}" bindtap="toggleDirectAddWord">
          <view class="direct-add-left">
            <text class="direct-add-badge">✨ 快捷添加</text>
            <text class="direct-add-word">{{cleanQueryWord}}</text>
          </view>
          <view class="select-checkbox {{selectedVocabMap[cleanQueryWord] ? 'checked' : ''}}">
            <text wx:if="{{selectedVocabMap[cleanQueryWord]}}">✓</text>
          </view>
        </view>

        <view class="vocab-items-grid" wx:if="{{filteredVocabList.length > 0}}">
          <view wx:for="{{filteredVocabList}}" wx:key="word" class="vocab-db-card {{selectedVocabMap[item.word] ? 'selected' : ''}}" data-word="{{item.word}}" bindtap="toggleSelectVocabItem">
            <view class="vocab-card-top">
              <view class="vocab-word-info">
                <text class="vocab-main-word">{{item.word}}</text>
                <text class="vocab-pos-tag" wx:if="{{item.pos}}">{{item.pos}}</text>
                <text class="vocab-ipa-text" wx:if="{{item.phonetic}}">{{item.phonetic}}</text>
              </view>
              <view class="select-checkbox {{selectedVocabMap[item.word] ? 'checked' : ''}}">
                <text wx:if="{{selectedVocabMap[item.word]}}">✓</text>
              </view>
            </view>
            <view class="vocab-card-bottom">
              <text class="vocab-def-text">{{item.def}}</text>
              <text class="vocab-cat-badge" wx:if="{{item.catName}}">{{item.catName}}</text>
            </view>
          </view>
        </view>
        <view class="vocab-empty-box" wx:elif="{{!isSearchingOnline && !cleanQueryWord}}">
          <text class="empty-emoji">💡</text>
          <text>输入任何英文单词或中文，全网词典实时检索并智能联想！</text>
        </view>
      </scroll-view>

      <!-- Bottom Action Footer -->
      <view class="vocab-modal-footer">
        <view class="footer-left">
          <text class="selected-counter" wx:if="{{selectedVocabCount > 0}}">已选 {{selectedVocabCount}} 词</text>
        </view>
        <view class="footer-right">
          <view class="text-btn-sm" bindtap="clearSelectedVocab" wx:if="{{selectedVocabCount > 0}}" style="margin-right: 12rpx;">清空</view>
          <view class="primary-btn-submit {{selectedVocabCount === 0 ? 'disabled' : ''}}" bindtap="applySelectedVocab">
            <text>一键填入 ({{selectedVocabCount}})</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
