/* pages/index/index.wxss */

.app-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  position: relative;
  background-color: var(--bg-app);
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* Header */
.app-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background-color: var(--bg-card);
  border-bottom: 2rpx solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: 100;
}

.logo {
  display: flex;
  align-items: center;
}

.logo-icon {
  font-size: 38rpx;
  color: var(--accent);
  margin-right: 12rpx;
  font-weight: bold;
}

.logo-text-group {
  display: flex;
  flex-direction: column;
}

.logo-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
}

.logo-sub {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.header-actions {
  display: flex;
  align-items: center;
}

.icon-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: var(--bg-card-hover);
  transition: var(--transition);
}

.emoji-icon {
  font-size: 32rpx;
}

/* Workspace */
.app-main {
  flex: 1;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* Input Card */
.input-card {
  background-color: var(--bg-card);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
}

.input-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.input-header-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.input-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.info-tip {
  font-size: 22rpx;
  color: var(--text-muted);
}

.clear-text-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(239, 68, 68, 0.08);
  color: #ef4444;
  border-radius: 20rpx;
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.clear-text-btn:active {
  background: rgba(239, 68, 68, 0.16);
  transform: scale(0.95);
}

.clear-icon {
  font-size: 20rpx;
}

.textarea-wrapper {
  background-color: var(--bg-app);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.words-textarea {
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.5;
}

.textarea-placeholder {
  color: var(--text-muted);
}

/* Action Control Zone */
.input-actions-zone {
  margin-top: 16rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 3 Unified Modern Tool Buttons */
.input-toolbar {
  display: flex;
  gap: 12rpx;
}

.tool-btn {
  flex: 1;
  background: var(--bg-card);
  border: 1.5rpx solid var(--border-color);
  border-radius: 16rpx;
  padding: 14rpx 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  white-space: nowrap;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.02);
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.tool-btn:active {
  background: #ffffff;
  border-color: rgba(99, 102, 241, 0.4);
  transform: translateY(-2rpx) scale(0.97);
  box-shadow: 0 6rpx 16rpx rgba(99, 102, 241, 0.12);
}

.tool-icon {
  font-size: 26rpx;
  line-height: 1;
  transition: transform 0.25s ease;
}

.tool-btn:active .tool-icon {
  transform: scale(1.2) rotate(-8deg);
}

/* Primary Submit CTA Button with Silky Shimmer Glow */
.primary-btn-submit-full {
  position: relative;
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 50%, #7c3aed 100%);
  color: #ffffff;
  border-radius: 20rpx;
  padding: 22rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  box-shadow: 0 8rpx 28rpx rgba(79, 70, 229, 0.28);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.primary-btn-submit-full::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(60deg, transparent 30%, rgba(255, 255, 255, 0.25) 50%, transparent 70%);
  transform: rotate(30deg);
  animation: shimmerSweep 4s infinite cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
}

@keyframes shimmerSweep {
  0% { transform: translateX(-100%) rotate(30deg); }
  35% { transform: translateX(100%) rotate(30deg); }
  100% { transform: translateX(100%) rotate(30deg); }
}

.primary-btn-submit-full:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 14rpx rgba(79, 70, 229, 0.35);
}

.primary-btn-submit-full.disabled {
  opacity: 0.6;
  pointer-events: none;
  box-shadow: none;
}

.submit-sparkle {
  font-size: 30rpx;
}

.submit-text {
  white-space: nowrap;
}

.spinner-small {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.spinner-small {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  border-top-color: #fff;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 80rpx 40rpx;
  background-color: var(--bg-card);
  border: 2rpx dashed var(--border-color);
  border-radius: var(--radius-lg);
  margin-top: 20rpx;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* Loading Card */
.loading-card {
  background-color: var(--bg-card);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  box-shadow: var(--shadow-sm);
}

.loading-skeleton-title {
  height: 36rpx;
  background-color: var(--bg-card-hover);
  border-radius: 8rpx;
  width: 40%;
  margin-bottom: 12rpx;
}

.loading-skeleton-text {
  height: 28rpx;
  background-color: var(--bg-card-hover);
  border-radius: 8rpx;
  width: 100%;
}

.loading-skeleton-text.half-width {
  width: 60%;
}

.skeleton-blink {
  animation: skeleton-pulse 1.2s infinite ease-in-out;
}

@keyframes skeleton-pulse {
  0% { opacity: 0.6; }
  50% { opacity: 0.3; }
  100% { opacity: 0.6; }
}

/* ========================================================
   ✨ Organic Story Atelier Loading Card Styles
   ======================================================== */
.loading-atelier-card {
  position: relative;
  background: linear-gradient(145deg, #fefce8 0%, #fef3c7 40%, #f3e8ff 100%);
  border: 2rpx solid rgba(245, 158, 11, 0.25);
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(245, 158, 11, 0.12);
  min-height: 480rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.atelier-bg-orbit {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(251, 191, 36, 0.15) 0%, transparent 60%);
  animation: rotateGlow 14s linear infinite;
  pointer-events: none;
}

@keyframes rotateGlow {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.atelier-core-group {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.atelier-orbit-ring {
  position: absolute;
  border-radius: 50%;
  border: 3rpx dashed rgba(217, 119, 6, 0.3);
}

.atelier-orbit-ring.ring-outer {
  width: 150rpx;
  height: 150rpx;
  animation: ringSpin 8s linear infinite;
}

.atelier-orbit-ring.ring-inner {
  width: 120rpx;
  height: 120rpx;
  border-color: rgba(168, 85, 247, 0.35);
  animation: ringSpin 5s linear infinite reverse;
}

@keyframes ringSpin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.atelier-quill-badge {
  position: relative;
  width: 90rpx;
  height: 90rpx;
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 28rpx rgba(245, 158, 11, 0.4);
  z-index: 2;
}

.quill-icon {
  font-size: 46rpx;
  animation: floatQuill 1.8s ease-in-out infinite alternate;
}

@keyframes floatQuill {
  0% { transform: translateY(0) rotate(0deg); }
  100% { transform: translateY(-8rpx) rotate(-12deg); }
}

.magic-sparkle {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  font-size: 28rpx;
  animation: spinSparkle 2.4s linear infinite;
}

@keyframes spinSparkle {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.atelier-status-info {
  text-align: center;
  z-index: 2;
  margin-bottom: 28rpx;
}

.atelier-status-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #78350f;
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
}

.atelier-status-sub {
  display: block;
  font-size: 24rpx;
  color: #92400e;
  padding: 6rpx 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1.5rpx solid rgba(245, 158, 11, 0.3);
  border-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.08);
}

.atelier-word-playground {
  position: relative;
  width: 100%;
  flex: 1;
  background: rgba(255, 255, 255, 0.85);
  border-radius: var(--radius-md);
  border: 2rpx dashed rgba(217, 119, 6, 0.3);
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  z-index: 2;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.atelier-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.hint-icon {
  font-size: 26rpx;
  animation: tapBounce 0.8s ease-in-out infinite alternate;
}

@keyframes tapBounce {
  0% { transform: translateY(0); }
  100% { transform: translateY(-4rpx); }
}

.hint-text {
  font-size: 22rpx;
  color: #64748b;
}

.combo-num {
  color: #e11d48;
  font-weight: 700;
  font-size: 26rpx;
  padding: 0 4rpx;
}

.atelier-bubbles-area {
  position: relative;
  width: 100%;
  height: 220rpx;
}

.atelier-bubble {
  position: absolute;
  padding: 14rpx 32rpx;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  animation: floatBubble 3.2s ease-in-out infinite alternate;
  cursor: pointer;
}

@keyframes floatBubble {
  0% { transform: translateY(0rpx) rotate(-2deg); }
  50% { transform: translateY(-15rpx) rotate(2deg); }
  100% { transform: translateY(5rpx) rotate(-1deg); }
}

.atelier-bubble:active {
  transform: scale(0.88);
}

.atelier-bubble.popped {
  transform: scale(1.4) rotate(10deg);
  opacity: 0.75;
}

.bubble-word {
  font-size: 27rpx;
  font-weight: 700;
  color: #ffffff;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.3);
  white-space: nowrap;
}

.bubble-sparkle {
  position: absolute;
  top: -24rpx;
  right: -10rpx;
  font-size: 20rpx;
  font-weight: 800;
  color: #fef08a;
  text-shadow: 0 0 10rpx rgba(250, 204, 21, 0.8);
  animation: riseSparkle 0.4s ease-out forwards;
}

@keyframes riseSparkle {
  0% { opacity: 0; transform: translateY(10rpx) scale(0.5); }
  100% { opacity: 1; transform: translateY(-15rpx) scale(1.2); }
}

.burst-sparks-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 10;
}

.burst-pop-text {
  position: absolute;
  font-size: 26rpx;
  font-weight: 800;
  color: #38bdf8;
  text-shadow: 0 0 12rpx rgba(56, 189, 248, 0.8);
  animation: popTextRise 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
}

@keyframes popTextRise {
  0% { opacity: 0; transform: scale(0.5) translateY(0); }
  50% { opacity: 1; transform: scale(1.2) translateY(-20rpx); }
  100% { opacity: 0; transform: scale(1) translateY(-40rpx); }
}

/* Output Panel */
.output-panel {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.story-card {
  background-color: var(--bg-card);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
}

.story-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 2rpx solid var(--border-color);
  padding-bottom: 18rpx;
  margin-bottom: 22rpx;
  gap: 12rpx;
}

.story-title-group {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  min-width: 0;
}

.story-title {
  font-size: 29rpx;
  font-weight: 700;
  color: var(--text-primary);
  white-space: nowrap;
}

.story-actions-group {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.speak-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background-color: var(--accent-subtle);
  color: var(--accent);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.speak-btn.speaking {
  background-color: var(--success);
  color: #ffffff;
}

.speak-icon {
  font-size: 26rpx;
}

.story-body {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.story-content {
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.7;
}

/* Make rich text strong tags look bold with accent color */
.story-content strong {
  font-weight: 700;
  color: var(--accent);
  background-color: var(--accent-glow);
  padding: 0 6rpx;
  border-radius: 6rpx;
}

.story-translation {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  border-top: 2rpx dashed var(--border-color);
  padding-top: 20rpx;
}

/* ========================================================
   🧩 Interactive Cloze Quiz Challenge Styles
   ======================================================== */
.story-card.quiz-active {
  border-color: rgba(99, 102, 241, 0.4);
  box-shadow: 0 8rpx 30rpx rgba(99, 102, 241, 0.08);
}

.quiz-badge-top {
  font-size: 19rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #ffffff;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  white-space: nowrap;
  animation: bounceIn 0.3s ease;
}

.quiz-mode-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: rgba(99, 102, 241, 0.08);
  border: 1rpx solid rgba(99, 102, 241, 0.25);
  color: #4f46e5;
  padding: 8rpx 16rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.quiz-mode-btn.active {
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
  color: #ffffff;
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.3);
}

.quiz-mode-btn:active {
  transform: scale(0.96);
}

.quiz-icon {
  font-size: 24rpx;
  line-height: 1;
}

.quiz-text {
  font-size: 22rpx;
  white-space: nowrap;
}

/* Compact Circular Action Buttons in Story Header */
.header-icon-btn {
  width: 52rpx !important;
  height: 52rpx !important;
  min-height: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
  border-radius: 50% !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  background: rgba(241, 245, 249, 0.85);
  border: 1.5rpx solid #e2e8f0;
  color: #475569;
  flex-shrink: 0;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.header-icon-btn:active {
  transform: scale(0.92);
  background: #e2e8f0;
}

.header-icon-btn .btn-icon {
  font-size: 24rpx;
  line-height: 1;
}

.header-icon-btn.speaking {
  background: #10b981 !important;
  color: #ffffff !important;
  border-color: transparent !important;
  animation: pulseSlot 1.2s infinite;
}

.quiz-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  animation: fadeIn 0.25s ease;
}

.quiz-instruction-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(248, 250, 252, 0.85);
  border: 1rpx solid #e2e8f0;
  padding: 10rpx 16rpx;
  border-radius: 14rpx;
}

.quiz-inst-text {
  font-size: 23rpx;
  color: #475569;
  font-weight: 500;
}

.quiz-reset-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  color: #6366f1;
  font-weight: 600;
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
  background: rgba(99, 102, 241, 0.08);
}

.quiz-reset-btn:active {
  transform: scale(0.95);
}

/* Cloze Story Paragraph with Interactive Slots */
.cloze-story-box {
  font-size: 31rpx;
  color: var(--text-primary);
  line-height: 2.1;
  letter-spacing: 0.5rpx;
  background: rgba(248, 250, 252, 0.5);
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  border: 1.5rpx solid rgba(226, 232, 240, 0.9);
}

.cloze-plain-text {
  color: var(--text-primary);
}

.cloze-blank-slot {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  min-width: 140rpx;
  height: 48rpx;
  margin: 0 8rpx;
  padding: 0 16rpx;
  vertical-align: middle;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Empty Blank Slot */
.cloze-blank-slot.slot-empty {
  border: 2rpx dashed #94a3b8;
  background: #ffffff;
  color: #94a3b8;
}

.cloze-blank-slot.slot-focused {
  border: 2rpx solid #4f46e5 !important;
  background: rgba(99, 102, 241, 0.08) !important;
  color: #4f46e5 !important;
  box-shadow: 0 0 0 4rpx rgba(99, 102, 241, 0.15);
  animation: pulseSlot 1.5s infinite;
}

@keyframes pulseSlot {
  0% { transform: scale(1); }
  50% { transform: scale(1.03); }
  100% { transform: scale(1); }
}

.slot-placeholder {
  font-size: 23rpx;
  font-weight: 500;
  color: #94a3b8;
}

/* Correct Blank Slot */
.cloze-blank-slot.slot-correct {
  border: 2rpx solid #10b981;
  background: rgba(16, 185, 129, 0.1);
  color: #047857;
  box-shadow: 0 2rpx 8rpx rgba(16, 185, 129, 0.15);
}

.slot-check-icon {
  font-size: 24rpx;
  font-weight: bold;
  color: #10b981;
}

/* Wrong Blank Slot */
.cloze-blank-slot.slot-wrong {
  border: 2rpx solid #ef4444;
  background: rgba(239, 68, 68, 0.1);
  color: #b91c1c;
  animation: shakeSlot 0.4s ease;
}

@keyframes shakeSlot {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-6rpx); }
  75% { transform: translateX(6rpx); }
}

/* Candidate Word Bank */
.quiz-bank-section {
  margin-top: 10rpx;
  background: #ffffff;
  border: 1.5rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
}

.bank-header-label {
  font-size: 23rpx;
  font-weight: 600;
  color: #64748b;
  margin-bottom: 14rpx;
}

.quiz-word-bank {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.quiz-word-pill {
  background: #ffffff;
  border: 1.5rpx solid #cbd5e1;
  border-radius: 30rpx;
  padding: 10rpx 24rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.quiz-word-pill:active {
  transform: scale(0.93);
}

.quiz-word-pill .pill-word-text {
  font-size: 27rpx;
  font-weight: 700;
  color: #1e293b;
}

.quiz-word-pill.used {
  opacity: 0.35;
  background: #f1f5f9;
  border-color: #e2e8f0;
  pointer-events: none;
  text-decoration: line-through;
}

/* Success Celebration Card */
.quiz-success-card {
  margin-top: 10rpx;
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(99, 102, 241, 0.08) 100%);
  border: 2rpx solid rgba(16, 185, 129, 0.35);
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  animation: popIn 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes popIn {
  0% { transform: scale(0.85); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.success-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.success-icon {
  font-size: 36rpx;
}

.success-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #047857;
}

.success-desc {
  font-size: 25rpx;
  color: #475569;
  line-height: 1.4;
}

.success-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.success-btn-replay {
  background: #ffffff;
  border: 1.5rpx solid rgba(16, 185, 129, 0.4);
  color: #047857;
  font-size: 25rpx;
  font-weight: 600;
  padding: 10rpx 22rpx;
  border-radius: 30rpx;
}

.success-btn-story {
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 600;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.25);
}

.quiz-trans-section {
  margin-top: 10rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed var(--border-color);
}

.quiz-trans-label {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--text-muted);
  margin-bottom: 6rpx;
}

/* Vocab Section */
.vocab-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-top: 10rpx;
}

.vocab-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.vocab-card {
  background-color: var(--bg-card);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.vocab-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.word-group {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex-wrap: wrap;
}

.vocab-word {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.vocab-ipa {
  font-size: 24rpx;
  color: var(--text-muted);
}

.word-speak-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background-color: var(--bg-card-hover);
  display: flex;
  align-items: center;
  justify-content: center;
}

.word-speak-icon {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.vocab-def-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.vocab-pos {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--accent);
  background-color: var(--accent-subtle);
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}

.vocab-definition {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

/* Polysemy Tag & Drawer Styles */
.polysemy-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(99, 102, 241, 0.08);
  border: 1rpx solid rgba(99, 102, 241, 0.25);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  cursor: pointer;
  transition: all 0.2s ease;
}

.polysemy-tag.active {
  background: #4f46e5;
  border-color: #4f46e5;
}

.polysemy-tag.active .polysemy-tag-text,
.polysemy-tag.active .polysemy-arrow {
  color: #ffffff;
}

.polysemy-tag-icon {
  font-size: 20rpx;
}

.polysemy-tag-text {
  font-size: 20rpx;
  font-weight: 600;
  color: #4f46e5;
}

.polysemy-arrow {
  font-size: 18rpx;
  color: #4f46e5;
}

.polysemy-drawer {
  background: var(--bg-app);
  border: 1.5rpx solid rgba(99, 102, 241, 0.2);
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
  margin: 6rpx 0;
  animation: fadeIn 0.2s ease;
}

.polysemy-drawer-header {
  margin-bottom: 12rpx;
}

.polysemy-tip {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.polysemy-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.polysemy-option {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ffffff;
  border: 1rpx solid var(--border-color);
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  transition: all 0.15s ease;
}

.polysemy-option:active {
  background: rgba(99, 102, 241, 0.06);
  border-color: #4f46e5;
}

.alt-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
}

.alt-pos {
  font-size: 20rpx;
  font-weight: 700;
  color: #4f46e5;
  background: rgba(99, 102, 241, 0.1);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.alt-def {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.alt-action-btn {
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  white-space: nowrap;
  box-shadow: 0 2rpx 6rpx rgba(79, 70, 229, 0.2);
}

.vocab-example-box {
  background-color: var(--bg-app);
  padding: 16rpx 20rpx;
  border-radius: var(--radius-sm);
  border-left: 4rpx solid var(--border-color);
  font-size: 24rpx;
  line-height: 1.5;
}

.example-label {
  color: var(--text-secondary);
  font-weight: 600;
}

.example-text {
  color: var(--text-primary);
  font-style: italic;
}

/* History Sidebar Drawer */
.sidebar-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background-color: rgba(15, 23, 42, 0.4);
  z-index: 200;
  opacity: 0;
  visibility: hidden;
  transition: all 0.28s ease;
}

.sidebar-backdrop.active {
  opacity: 1;
  visibility: visible;
}

.history-sidebar {
  position: fixed;
  top: 0;
  right: 0;
  width: 540rpx;
  height: 100vh;
  background-color: var(--bg-card);
  z-index: 201;
  box-shadow: -10rpx 0 30rpx rgba(0, 0, 0, 0.05);
  transform: translateX(100%);
  transition: all 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
}

.history-sidebar.active {
  transform: translateX(0);
}

.sidebar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.sidebar-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.clear-history-btn {
  font-size: 24rpx;
  color: var(--text-muted);
}

.sidebar-scroll {
  flex: 1;
}

.history-list {
  display: flex;
  flex-direction: column;
}

.history-item {
  padding: 24rpx 32rpx;
  border-bottom: 2rpx solid var(--border-color);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.history-item:active {
  background-color: var(--bg-card-hover);
}

.history-words {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.history-time {
  font-size: 20rpx;
  color: var(--text-muted);
}

.history-empty {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 40rpx;
  font-size: 26rpx;
  color: var(--text-muted);
}

/* Crop Editor Styling (Fullscreen Layout) */
.crop-editor-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background-color: #0f172a; /* Dark background to highlight image */
  z-index: 220; /* Overlays navigation bars and tabs */
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-top: calc(20rpx + env(safe-area-inset-top));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.crop-editor-card {
  background-color: transparent;
  border: none;
  border-radius: 0;
  width: 100%;
  height: 100%;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
  gap: 16rpx;
  box-shadow: none;
}

.crop-editor-header {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.crop-editor-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff; /* Bright title on dark backdrop */
}

.crop-editor-tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.crop-editor-body {
  background-color: #090d16;
  border-radius: var(--radius-lg);
  padding: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1; /* Stretch to occupy all vertical screen space */
  margin: 16rpx 0;
  box-sizing: border-box;
  overflow: hidden;
}

.crop-image-container {
  overflow: hidden;
  box-sizing: border-box;
}

.crop-source-img {
  width: 100%;
  height: 100%;
  display: block;
}

.crop-highlight-canvas {
  touch-action: none;
}

.crop-editor-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
}

.crop-editor-footer .text-btn-sm {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  padding: 12rpx 24rpx;
}

.crop-footer-right {
  display: flex;
  gap: 20rpx;
}

.crop-footer-right .secondary-btn-sm {
  background-color: rgba(255, 255, 255, 0.1);
  color: #ffffff;
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  padding: 16rpx 36rpx;
}

.crop-footer-right .secondary-btn-sm:active {
  background-color: rgba(255, 255, 255, 0.2);
}

.crop-footer-right .primary-btn-submit {
  background-color: var(--accent);
  color: #ffffff;
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  font-weight: 600;
  padding: 16rpx 40rpx;
}

.brush-size-selector {
  display: flex;
  align-items: center;
  gap: 28rpx;
  background-color: rgba(255, 255, 255, 0.08);
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
}

.brush-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.35);
  position: relative;
  transition: all 0.2s ease;
}

.brush-dot.thin {
  transform: scale(0.65);
}

.brush-dot.medium {
  transform: scale(1.0);
}

.brush-dot.thick {
  transform: scale(1.35);
}

.brush-dot.active {
  background-color: #ffd700;
  box-shadow: 0 0 12rpx rgba(255, 215, 0, 0.6);
}

.brush-dot.active::after {
  content: '';
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border: 2rpx solid #ffd700;
  border-radius: 50%;
}

.crop-header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.draw-mode-selector {
  display: flex;
  background-color: rgba(255, 255, 255, 0.08);
  border-radius: 30rpx;
  padding: 4rpx;
}

.mode-btn {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  padding: 8rpx 20rpx;
  border-radius: 26rpx;
  transition: all 0.2s ease;
}

.mode-btn.active {
  background-color: var(--accent);
  color: #ffffff;
  font-weight: 500;
}

/* Story and Vocab Actions group layout */
.story-actions-group {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.share-story-btn {
  background-color: var(--bg-card-hover);
  color: var(--text-secondary);
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  font-weight: 500;
  padding: 12rpx 24rpx;
  border: none;
  min-height: 0 !important;
  width: auto !important;
  display: flex;
  align-items: center;
  gap: 6rpx;
  line-height: 1;
}

.share-story-btn:active {
  background-color: var(--border-color);
  transform: scale(0.96);
}

.share-icon {
  font-size: 26rpx;
}

.vocab-actions-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.word-favorite-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: var(--bg-card-hover);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.word-favorite-btn:active {
  transform: scale(0.85);
}

.word-favorite-btn .fav-icon {
  font-size: 28rpx;
  color: var(--text-muted);
}

.word-favorite-btn.active .fav-icon {
  color: #ffd700; /* Gold star color */
  text-shadow: 0 0 4rpx rgba(255, 215, 0, 0.4);
}

/* Favorites Sidebar (Slides out from Left) */
.favorites-sidebar {
  position: fixed;
  top: 0;
  left: 0;
  width: 560rpx;
  height: 100vh;
  background-color: var(--bg-card);
  z-index: 201;
  box-shadow: 10rpx 0 30rpx rgba(0, 0, 0, 0.05);
  transform: translateX(-100%);
  transition: all 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
}

.favorites-sidebar.active {
  transform: translateX(0);
}

.fav-list {
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  gap: 20rpx;
}

.fav-item {
  padding: 24rpx;
  border-radius: var(--radius-md);
  background-color: var(--bg-app);
  border: 2rpx solid var(--border-color);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.fav-item-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.fav-word-group {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}

.fav-word {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.fav-def {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.fav-actions {
  display: flex;
  gap: 16rpx;
}

.fav-action-btn {
  font-size: 24rpx;
  background-color: var(--bg-card);
  border-radius: 50%;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--border-color);
}

.fav-action-btn:active {
  transform: scale(0.9);
  background-color: var(--bg-card-hover);
}

.fav-action-btn.delete {
  color: #ef4444; /* red icon */
}

.fav-example {
  margin-top: 4rpx;
  padding-top: 8rpx;
  border-top: 2rpx dashed var(--border-color);
}

.fav-example-text {
  font-size: 22rpx;
  color: var(--text-muted);
  font-style: italic;
}

/* ==========================================================================
   Word Index & Chinese Word Selection Modal (Bottom Sheet Dialog)
   ========================================================================== */
.vocab-modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(15, 23, 42, 0.6);
  backdrop-filter: blur(8px);
  z-index: 300;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.vocab-modal-card {
  width: 100%;
  height: 80vh;
  background: var(--bg-card);
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.15);
  animation: slideUp 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  overflow: hidden;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.vocab-modal-header {
  padding: 32rpx 36rpx 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  border-bottom: 1.5rpx solid var(--border-color);
}

.vocab-header-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.vocab-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.vocab-modal-sub {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.close-modal-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bg-app);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--text-muted);
}

/* Search Box */
.vocab-search-box {
  margin: 20rpx 36rpx 14rpx;
  background: var(--bg-app);
  border: 2rpx solid #6366f1;
  border-radius: 24rpx;
  padding: 18rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(99, 102, 241, 0.1);
}

.search-lens-icon {
  font-size: 30rpx;
}

.vocab-search-field {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.clear-search-btn {
  font-size: 26rpx;
  color: var(--text-muted);
  padding: 8rpx;
}

/* Vocab List Scroll */
.vocab-list-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
  padding: 16rpx 36rpx;
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
}

.vocab-searching-indicator {
  padding: 12rpx 0 20rpx;
  text-align: center;
}

.search-loading-text {
  font-size: 24rpx;
  color: #6366f1;
  font-weight: 500;
  animation: pulse 1.5s infinite ease-in-out;
}

.vocab-direct-add-card {
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.08) 0%, rgba(168, 85, 247, 0.08) 100%);
  border: 2rpx dashed #6366f1;
  border-radius: 20rpx;
  padding: 20rpx 26rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.direct-add-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.direct-add-badge {
  font-size: 20rpx;
  background: #6366f1;
  color: #ffffff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.direct-add-word {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.vocab-items-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-bottom: 20rpx;
}

.vocab-db-card {
  background: var(--bg-card);
  border: 2rpx solid var(--border-color);
  border-radius: 20rpx;
  padding: 22rpx 26rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  transition: all 0.2s ease;
}

.vocab-db-card.selected {
  border-color: #4f46e5;
  background: rgba(99, 102, 241, 0.06);
  box-shadow: 0 4rpx 16rpx rgba(79, 70, 229, 0.15);
}

.vocab-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.vocab-word-info {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex-wrap: wrap;
}

.vocab-main-word {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.vocab-pos-tag {
  font-size: 22rpx;
  color: #6366f1;
  font-weight: 600;
}

.vocab-ipa-text {
  font-size: 22rpx;
  color: var(--text-muted);
  font-family: monospace;
}

.select-checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #ffffff;
  background: var(--bg-app);
  transition: all 0.2s ease;
}

.select-checkbox.checked {
  background: #4f46e5;
  border-color: #4f46e5;
}

.vocab-card-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.vocab-def-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  flex: 1;
}

.vocab-cat-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  background: rgba(16, 185, 129, 0.12);
  color: #059669;
  border: 1rpx solid rgba(16, 185, 129, 0.25);
  font-weight: 500;
}

.vocab-empty-box {
  padding: 80rpx 20rpx;
  text-align: center;
  color: var(--text-muted);
  font-size: 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-emoji {
  font-size: 60rpx;
}

/* Modal Footer */
.vocab-modal-footer {
  padding: 20rpx 36rpx 40rpx;
  border-top: 1.5rpx solid var(--border-color);
  background: var(--bg-card);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.footer-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.selected-counter {
  font-size: 26rpx;
  font-weight: 600;
  color: #4f46e5;
}

.footer-right {
  display: flex;
  align-items: center;
}
